APP_NAME=MedTrack
APP_ENV=production
APP_KEY=base64:REPLACE_WITH_A_REAL_LARAVEL_KEY
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_PORT=8080

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=medtrack
DB_USERNAME=medtrack_app
DB_PASSWORD=CHANGE_THIS_APP_PASSWORD
DB_ROOT_PASSWORD=CHANGE_THIS_ROOT_PASSWORD

ADMINER_PORT=8081
RUN_MIGRATIONS=true

FILESYSTEM_DISK=local
