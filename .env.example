APP_NAME="Medical Inventory"
APP_KEY=
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=medical_inventory
DB_USERNAME=medtrack_user
DB_PASSWORD=medtrack_secret
# Local non-Docker fallback (php artisan serve + SQLite):
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

# Initial administrator (used by the Docker entrypoint provisioning step).
# Set both email and password to create the first admin on boot; leave blank
# to skip. The password must be at least 12 characters.
MEDTRACK_ADMIN_NAME=Administrator
MEDTRACK_ADMIN_EMAIL=
MEDTRACK_ADMIN_PASSWORD=

# Seed demo users alongside baseline structure in any environment (defaults to
# enabled automatically in the local environment). Never enable in production.
SEED_DEMO_USERS=false

# Reject authenticated requests from unverified accounts. Disabled by default
# because staff accounts are verified directly by administrators.
REQUIRE_EMAIL_VERIFICATION=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
