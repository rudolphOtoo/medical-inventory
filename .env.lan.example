APP_NAME="Medical Inventory"
APP_KEY=
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080

# Host port the LAN deployment is published on (docker-compose.lan.yml maps
# ${APP_PORT:-8080} -> container port 80). Compose reads this from `.env` in
# the project root, not from `.env.lan`, so set it there to change the port.
APP_PORT=8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=medical_inventory
DB_USERNAME=medtrack_user
DB_PASSWORD=medtrack_secret
# APP_URL must match how you browse the app on the LAN, e.g.:
# APP_URL=http://192.168.1.50:8080

# Initial administrator (used by the Docker entrypoint provisioning step).
# Set both email and password to create the first admin on boot; leave blank
# to skip. The password must be at least 12 characters.
MEDTRACK_ADMIN_NAME=Administrator
MEDTRACK_ADMIN_EMAIL=
MEDTRACK_ADMIN_PASSWORD=

# Plant demo users/records alongside the structural baseline. Never enable in a
# real production deployment; the baseline departments are seeded regardless.
SEED_DEMO_USERS=false

# Reject authenticated requests from unverified accounts. Left off because
# staff accounts are verified directly by administrators.
REQUIRE_EMAIL_VERIFICATION=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@medical-inventory.local"
MAIL_FROM_NAME="${APP_NAME}"
